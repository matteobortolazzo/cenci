#!/usr/bin/env bash
set -euo pipefail

# ── Auto-detect container runtime ────────────────────────────────
if command -v podman &>/dev/null; then
    RUNTIME=podman
elif command -v docker &>/dev/null; then
    RUNTIME=docker
else
    echo "Error: neither podman nor docker found." >&2
    exit 1
fi

# ── Configuration ────────────────────────────────────────────────
MONOLITH_IMAGE="agent-sandbox:latest"
WORKSPACE_HOST="${HOME}/Repos"
WORKSPACE_CONTAINER="/workspace"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# ── Resolve BASE_TAG via content hash ─────────────────────────────
# Portable content hash of all Dockerfile.base build inputs
# (Dockerfile.base + entrypoint.sh + everything COPYed from lib/). Rebuilds the
# base only when those inputs change — not on every plugin.json version bump.
# Prefers sha256sum (Linux); falls back to shasum -a 256 (macOS). Paths are
# RELATIVE (subshell cd) so the digest is identical here and in smoke.test.sh
# regardless of the absolute checkout path.
if command -v sha256sum &>/dev/null; then
    HASH_CMD=(sha256sum)
elif command -v shasum &>/dev/null; then
    HASH_CMD=(shasum -a 256)
else
    echo "Error: neither sha256sum nor shasum on PATH — cannot resolve base tag." >&2
    exit 1
fi

if ! BASE_TAG_FILES="$(cd "${SCRIPT_DIR}" && find Dockerfile.base entrypoint.sh lib -type f)"; then
    echo "Error: failed to enumerate base image build inputs (Dockerfile.base, entrypoint.sh, lib/)." >&2
    exit 1
fi
if [[ -z "${BASE_TAG_FILES}" ]]; then
    echo "Error: no base image build inputs found (Dockerfile.base, entrypoint.sh, lib/)." >&2
    exit 1
fi
BASE_TAG="$(
    cd "${SCRIPT_DIR}" &&
    LC_ALL=C sort <<<"${BASE_TAG_FILES}" |
        xargs -r "${HASH_CMD[@]}" |
        "${HASH_CMD[@]}" |
        cut -c1-12
)"
if [[ -z "${BASE_TAG}" ]]; then
    echo "Error: failed to compute base image content hash." >&2
    exit 1
fi
BASE_IMAGE="agent-sandbox-base:${BASE_TAG}"

# ── Parse options ────────────────────────────────────────────────
AGENT=claude

# ── Model shortcut (first argument only) ──────────────────────────
# One-token agent+model shorthand: ch/cs/co/cf pick Claude and its
# haiku/sonnet/opus/fable alias; xl/xt/xs pick Codex and its luna/terra/sol
# model. Only recognized as the very first argument so it can never shadow a
# flag or a literal prompt string later in AGENT_ARGS.
declare -A CLAUDE_MODEL_SHORTCUTS=([ch]=haiku [cs]=sonnet [co]=opus [cf]=fable)
declare -A CODEX_MODEL_SHORTCUTS=([xl]=gpt-5.6-luna [xt]=gpt-5.6-terra [xs]=gpt-5.6-sol)
MODEL=""
# SHORTCUT_AGENT records the agent a shortcut implied (empty if no shortcut
# was used). It lets the parser below reject a later explicit --agent that
# desyncs the agent/model pair a shortcut selected together (e.g. `sb ch
# --agent codex` would otherwise silently run the codex agent with a claude
# model) instead of launching the mismatched combination.
SHORTCUT_TOKEN=""
SHORTCUT_AGENT=""
if [[ $# -gt 0 && -n "${CLAUDE_MODEL_SHORTCUTS[$1]+_}" ]]; then
    AGENT=claude
    MODEL="${CLAUDE_MODEL_SHORTCUTS[$1]}"
    SHORTCUT_TOKEN="$1"
    SHORTCUT_AGENT="${AGENT}"
    shift
elif [[ $# -gt 0 && -n "${CODEX_MODEL_SHORTCUTS[$1]+_}" ]]; then
    AGENT=codex
    MODEL="${CODEX_MODEL_SHORTCUTS[$1]}"
    SHORTCUT_TOKEN="$1"
    SHORTCUT_AGENT="${AGENT}"
    shift
fi

INSTANCE_NAME="default"
NAME_GIVEN=false
AGENT_GIVEN=false
BUILD_ONLY=false
BUILD_BASE_ONLY=false
SHELL_ONLY=false
HOST_NETWORK=false
DOCKER_SOCKET=false
UPDATE_PLUGINS=false
PRUNE=false
PRUNE_VOLUMES=false
RESEED_CREDS=false
REAP_ORPHANS=false
AGENT_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --agent)
            AGENT="$2"
            AGENT_GIVEN=true
            shift 2
            ;;
        --agent=*)
            AGENT="${1#*=}"
            AGENT_GIVEN=true
            shift
            ;;
        --name)
            INSTANCE_NAME="$2"
            NAME_GIVEN=true
            shift 2
            ;;
        --name=*)
            INSTANCE_NAME="${1#*=}"
            NAME_GIVEN=true
            shift
            ;;
        --build)
            BUILD_ONLY=true
            shift
            ;;
        --build-base)
            BUILD_BASE_ONLY=true
            shift
            ;;
        --shell)
            SHELL_ONLY=true
            shift
            ;;
        --host-network)
            HOST_NETWORK=true
            shift
            ;;
        --docker)
            DOCKER_SOCKET=true
            shift
            ;;
        --update-plugins)
            UPDATE_PLUGINS=true
            shift
            ;;
        --prune)
            PRUNE=true
            shift
            ;;
        --reap-orphans)
            REAP_ORPHANS=true
            shift
            ;;
        --volumes)
            PRUNE_VOLUMES=true
            shift
            ;;
        --reseed-creds)
            RESEED_CREDS=true
            shift
            ;;
        --model)
            # Recognized explicitly (rather than falling through to the
            # generic passthrough below) so the launcher never emits two
            # `--model` flags to the agent CLI: this value flows into the
            # same MODEL variable the shortcuts and the per-agent default
            # use, and AGENT_CMD_ARGS below always injects exactly one.
            MODEL="$2"
            shift 2
            ;;
        --model=*)
            MODEL="${1#*=}"
            shift
            ;;
        --)
            # Escape hatch: everything after a bare `--` is forwarded to the
            # agent CLI verbatim, with no further parsing or validation. This
            # is how flags cenci-sand doesn't recognize (a future
            # claude/codex flag, or anything not worth teaching this parser
            # about) still reach the agent CLI, now that unknown long flags
            # below are rejected instead of silently forwarded.
            shift
            AGENT_ARGS+=("$@")
            shift $#
            ;;
        --*)
            echo "Error: unknown flag '$1'. Recognized cenci-sand flags: --agent, --name, --model, --build, --build-base, --shell, --host-network, --docker, --update-plugins, --prune, --volumes, --reap-orphans, --reseed-creds. To pass a flag through to the agent CLI verbatim (e.g. an agent-specific flag cenci-sand doesn't know about), put it after a '--' separator: cenci-sand -- ${1}" >&2
            exit 1
            ;;
        *)
            AGENT_ARGS+=("$1")
            shift
            ;;
    esac
done

# Validate the selected agent.
case "${AGENT}" in
    claude|codex) ;;
    *)
        echo "Error: unknown agent '${AGENT}'. Valid agents: claude, codex." >&2
        exit 1
        ;;
esac

# A model shortcut (ch/cs/co/cf, xl/xt/xs) implies a specific agent. If a
# later explicit --agent disagrees, launching would silently pair the wrong
# agent with the shortcut's model (e.g. `cenci-sand ch --agent codex` running codex
# with a claude model) -- reject the conflicting combination instead.
if [[ -n "${SHORTCUT_AGENT}" ]] && "${AGENT_GIVEN}" && [[ "${AGENT}" != "${SHORTCUT_AGENT}" ]]; then
    echo "Error: shortcut '${SHORTCUT_TOKEN}' selects the ${SHORTCUT_AGENT} agent, but --agent ${AGENT} was also given. Drop the shortcut or the --agent flag so they agree." >&2
    exit 1
fi

# --volumes only means something combined with --prune (it controls whether
# --prune also lists/removes stale *-sand-home-* volumes); on its own it used
# to be a silent no-op.
if "${PRUNE_VOLUMES}" && ! "${PRUNE}"; then
    echo "Error: --volumes has no effect without --prune. Did you mean 'cenci-sand --prune --volumes'?" >&2
    exit 1
fi

# Model defaults per agent, applied unless a shortcut (ch/cs/co/cf, xl/xt/xs)
# or an explicit --model already set MODEL above.
if [[ -z "${MODEL}" ]]; then
    if [[ "${AGENT}" == codex ]]; then
        MODEL=gpt-5.6-terra
    else
        MODEL=sonnet
    fi
fi

# ── Prune (--prune) ───────────────────────────────────────────────
# Cleans up superseded agent-sandbox-base tags, dangling images, and stopped
# sandbox containers. Runs before repo scoping so it works outside a git repo
# too. Volumes are left alone unless --volumes is also given, and even then
# only after an interactive y/Y confirmation — they hold copied credentials
# and full session history.
if "${PRUNE}"; then
    echo "Removing superseded agent-sandbox-base tags..."
    IMAGE_LIST="$("${RUNTIME}" images --format '{{.Repository}}:{{.Tag}}' agent-sandbox-base)" || {
        echo "Error: failed to list agent-sandbox-base images." >&2
        exit 1
    }
    if [[ -n "${IMAGE_LIST}" ]]; then
        while read -r tag; do
            [[ "${tag}" == "${BASE_IMAGE}" || "${tag}" == "agent-sandbox-base:latest" ]] && continue
            echo "  removing ${tag}"
            "${RUNTIME}" rmi "${tag}" || true
        done <<< "${IMAGE_LIST}"
    fi

    echo "Removing stopped sandbox containers..."
    CONTAINER_LIST="$("${RUNTIME}" ps -a --filter status=exited --filter status=created --format '{{.Names}}')" || {
        echo "Error: failed to list sandbox containers." >&2
        exit 1
    }
    MATCHING_CONTAINERS="$(echo "${CONTAINER_LIST}" | { grep -E -- '^(claude-sand-|codex-sand-)' || true; })"
    if [[ -n "${MATCHING_CONTAINERS}" ]]; then
        while read -r name; do
            echo "  removing ${name}"
            "${RUNTIME}" rm "${name}" || true
        done <<< "${MATCHING_CONTAINERS}"
    fi

    echo "Pruning dangling images..."
    "${RUNTIME}" image prune -f

    if "${PRUNE_VOLUMES}"; then
        VOLUME_LIST="$("${RUNTIME}" volume ls --format '{{.Name}}')" || {
            echo "Error: failed to list sandbox volumes." >&2
            exit 1
        }
        VOLUMES="$(echo "${VOLUME_LIST}" | { grep -E -- '^(claude|codex)-sand-home-' || true; })"
        if [[ -n "${VOLUMES}" ]]; then
            echo "The following volumes hold copied credentials and full session history:" >&2
            echo "${VOLUMES}" >&2
            read -r -p "Remove these volumes? [y/N] " CONFIRM || CONFIRM=""
            if [[ "${CONFIRM}" == "y" || "${CONFIRM}" == "Y" ]]; then
                echo "${VOLUMES}" | xargs -r "${RUNTIME}" volume rm
            else
                echo "Skipping volume removal."
            fi
        else
            echo "No sandbox volumes found."
        fi
    fi

    exit 0
fi

# ── Reap orphans (--reap-orphans) ───────────────────────────────────
# Kills container-side agent processes whose owning tmux pane no longer
# exists on the host. Ownership is recorded via the TMUX_PANE env var that
# EXEC_ENV_ARGS injects into every exec'd session, present in
# /proc/<pid>/environ of every container-side agent process and descendants.
# Runs before repo scoping (global sweep, not scoped to the current repo) and
# scans every installed runtime independently of the single auto-detected
# RUNTIME used elsewhere in this script, since orphans can exist under either
# docker or podman regardless of which one is preferred here.
#
# Minimal POSIX in-container scan: emits "<pid>\t<pane>\t<start>" for every
# process whose environ carries a TMUX_PANE key (pane may be empty; <start>
# is that process's start time, /proc/<pid>/stat field 22, read in the same
# loop pass -- no extra per-process exec round-trip; empty if the stat line
# couldn't be read/parsed), skipping processes lacking the TMUX_PANE key
# entirely. All classification -- skip-empty-pane, skip-malformed-pane
# (pane-format validation against tmux's real pane-id format ^%[0-9]+$),
# skip-live-pane, reap-dead-pane, TERM->KILL escalation, PID-reuse
# detection, no-tmux handling -- happens host-side below, never inside this
# canned scan.
# shellcheck disable=SC2016 # single-quoted on purpose: these $vars must expand
# inside the container's sh -c, not on the host where this string is defined.
REAP_SCAN_SCRIPT='for e in /proc/[0-9]*/environ; do [ -f "$e" ] || continue; p=${e#/proc/}; p=${p%/environ}; line=$(tr "\0" "\n" < "$e" 2>/dev/null | grep "^TMUX_PANE=") || continue; st=$(cat "/proc/$p/stat" 2>/dev/null); st=${st##*) }; set -- $st; if [ "$#" -ge 20 ]; then shift 19; start=$1; else start=""; fi; printf "%s\t%s\t%s\n" "$p" "${line#TMUX_PANE=}" "$start"; done'

# Pre-SIGKILL liveness/identity probe (replaces the ambiguous `kill -0`
# check): invoked as `sh -c "${REAP_LIVENESS_SCRIPT}" _ "${pid}"` -- pid is
# passed as an argument, never interpolated into the script text. Reads
# /proc/<pid>/stat field 22 and prints the process's *current* start time on
# stdout if it is still alive, or the sentinel __GONE__ if it is not (stat
# unreadable/empty, i.e. no such process). Prints __NOSTAT__ if the process
# exists but its stat line couldn't be parsed into 20+ fields (edge case:
# alive but unverifiable). Always exits 0 if it ran at all, so a non-zero
# exit from the surrounding `<rt> exec` call means the exec transport itself
# failed (container gone / daemon unreachable), not "process gone" -- see
# reap_orphans()'s escalation loop for the host-side classification
# (transport failure / gone / PID-reuse mismatch / unverifiable / match).
# shellcheck disable=SC2016 # single-quoted on purpose: $1/$# are the probe's
# own positional parameters, expanded inside the container's sh -c, not here.
REAP_LIVENESS_SCRIPT='pid="$1"; st=$(cat "/proc/$pid/stat" 2>/dev/null); if [ -z "$st" ]; then printf "__GONE__\n"; exit 0; fi; st=${st##*) }; set -- $st; if [ "$#" -ge 20 ]; then shift 19; printf "%s\n" "$1"; else printf "__NOSTAT__\n"; fi; exit 0'

reap_orphans() {
    # Read once; CENCI_SANDBOX_REAP_GRACE_SECS lets callers tune the SIGTERM ->
    # SIGKILL grace window (e.g. to 0 for fast test runs).
    local grace="${CENCI_SANDBOX_REAP_GRACE_SECS:-5}"

    local tmp_dir
    tmp_dir="$(mktemp -d)" || { echo "Error: failed to create temp directory." >&2; return 1; }
    trap 'rm -rf "${tmp_dir}"' RETURN

    # ── Host tmux liveness ──────────────────────────────────────────
    local tmux_out tmux_exit tmux_err
    if tmux_out="$(tmux list-panes -a -F '#{pane_id}' 2>"${tmp_dir}/tmux.err")"; then
        tmux_exit=0
    else
        tmux_exit=$?
    fi
    tmux_err="$(cat "${tmp_dir}/tmux.err" 2>/dev/null || true)"

    local -A LIVE_PANES=()
    local no_tmux_server=false
    if [[ "${tmux_exit}" -eq 0 ]]; then
        while IFS= read -r pane; do
            [[ -n "${pane}" ]] && LIVE_PANES["${pane}"]=1
        done <<< "${tmux_out}"
    elif grep -qi 'no server running' <<< "${tmux_err}"; then
        no_tmux_server=true
        echo "Note: No tmux server detected; treating every TMUX_PANE-carrying process as orphaned."
    else
        echo "Error: failed to query tmux panes: ${tmux_err}" >&2
        return 1
    fi

    # ── Runtimes to scan (independent of the single auto-detected RUNTIME) ──
    local AVAILABLE_RUNTIMES=()
    command -v docker &>/dev/null && AVAILABLE_RUNTIMES+=(docker)
    command -v podman &>/dev/null && AVAILABLE_RUNTIMES+=(podman)
    if [[ "${#AVAILABLE_RUNTIMES[@]}" -eq 0 ]]; then
        echo "Error: no container runtime (docker/podman) found on PATH." >&2
        return 1
    fi

    local reaped_count=0
    local rt
    for rt in "${AVAILABLE_RUNTIMES[@]}"; do
        local container_list
        if ! container_list="$("${rt}" ps --format '{{.Names}}')"; then
            echo "Error: failed to list running containers for ${rt}." >&2
            return 1
        fi

        local matching_containers
        matching_containers="$(echo "${container_list}" | { grep -E -- '^(claude-sand-|codex-sand-)' || true; })"
        [[ -z "${matching_containers}" ]] && continue

        local container
        while IFS= read -r container; do
            [[ -z "${container}" ]] && continue

            # -u root: the container's persisted Config.User (from a prior
            # `docker run --user X`) may not be root, and this environ scan
            # needs to read every process's /proc/<pid>/environ, not just
            # those owned by the default user.
            local scan_out scan_exit
            if scan_out="$("${rt}" exec -u root "${container}" sh -c "${REAP_SCAN_SCRIPT}" 2>"${tmp_dir}/scan.err")"; then
                scan_exit=0
            else
                scan_exit=$?
            fi
            if [[ "${scan_exit}" -ne 0 ]]; then
                echo "Error: failed to scan processes in container ${container}: $(cat "${tmp_dir}/scan.err" 2>/dev/null || true)" >&2
                return 1
            fi
            [[ -z "${scan_out}" ]] && continue

            local term_pids=()
            local term_starts=()
            local pid pane start
            while IFS=$'\t' read -r pid pane start; do
                [[ -z "${pid}" ]] && continue
                [[ -z "${pane}" ]] && continue

                if [[ ! "${pane}" =~ ^%[0-9]+$ ]]; then
                    echo "Note: process ${pid} in container ${container} has a malformed TMUX_PANE value; skipping."
                    continue
                fi

                if ! "${no_tmux_server}" && [[ -n "${LIVE_PANES[${pane}]+_}" ]]; then
                    continue
                fi

                # -u root: see comment above the scan call.
                local term_exit
                if "${rt}" exec -u root "${container}" kill -TERM "${pid}"; then
                    term_exit=0
                else
                    term_exit=$?
                fi
                if [[ "${term_exit}" -ne 0 ]]; then
                    echo "Error: failed to send SIGTERM to pid ${pid} in container ${container}." >&2
                    return 1
                fi
                printf 'reaped\t%s\t%s\t%s\n' "${container}" "${pid}" "${pane}"
                reaped_count=$((reaped_count + 1))
                term_pids+=("${pid}")
                term_starts+=("${start}")
            done <<< "${scan_out}"

            if [[ "${#term_pids[@]}" -gt 0 ]]; then
                sleep "${grace}"
                local i
                for i in "${!term_pids[@]}"; do
                    pid="${term_pids[$i]}"
                    local recorded_start="${term_starts[$i]}"

                    # -u root: see comment above the scan call. Pid is passed
                    # as an argument to the probe, never interpolated. This
                    # replaces the ambiguous `kill -0` check: exit status is
                    # captured explicitly (function-as-condition set -e
                    # suspension -- see dev-sandbox/CLAUDE.md) so a non-zero
                    # exit here means the exec transport itself failed, not
                    # "process gone" -- a hard error, not swallowed.
                    local probe_out probe_exit
                    if probe_out="$("${rt}" exec -u root "${container}" sh -c "${REAP_LIVENESS_SCRIPT}" _ "${pid}" 2>"${tmp_dir}/liveness.err")"; then
                        probe_exit=0
                    else
                        probe_exit=$?
                    fi
                    if [[ "${probe_exit}" -ne 0 ]]; then
                        echo "Error: failed to probe liveness of pid ${pid} in container ${container}: $(cat "${tmp_dir}/liveness.err" 2>/dev/null || true)" >&2
                        return 1
                    fi

                    # __GONE__: process already gone by probe time -- no-op,
                    # not an error.
                    if [[ "${probe_out}" == "__GONE__" ]]; then
                        continue
                    fi

                    # A recorded start and a probe start that are both
                    # strictly numeric and differ means the pid was reused by
                    # an unrelated process during the grace window -- treat
                    # as already-gone, skip SIGKILL, not an error. Both sides
                    # must be validated as numeric before trusting a mismatch
                    # as genuine PID reuse: a forging process can corrupt its
                    # own /proc/stat field-22 (e.g. via a crafted comm) or
                    # shift the scan's TSV columns (e.g. an embedded-tab
                    # TMUX_PANE), producing a non-numeric recorded_start or
                    # probe_out that isn't __NOSTAT__/__GONE__. Both vectors
                    # are confined to the forging process's own record, so
                    # this is unparseable-value handling, not a security
                    # boundary. __NOSTAT__ (stat unparseable but process
                    # exists) and an empty recorded start (scan couldn't read
                    # stat at scan time) fall back to liveness-only silently;
                    # a non-empty-but-non-numeric value on either side falls
                    # back the same way but is noted since it's unexpected.
                    if [[ "${recorded_start}" =~ ^[0-9]+$ && "${probe_out}" =~ ^[0-9]+$ ]]; then
                        if [[ "${probe_out}" != "${recorded_start}" ]]; then
                            continue
                        fi
                    elif [[ ( -n "${recorded_start}" && ! "${recorded_start}" =~ ^[0-9]+$ ) \
                         || ( "${probe_out}" != "__NOSTAT__" && ! "${probe_out}" =~ ^[0-9]+$ ) ]]; then
                        echo "Note: process ${pid} in container ${container} has an unparseable start-time value; proceeding best-effort."
                    fi

                    local kill_exit
                    if "${rt}" exec -u root "${container}" kill -KILL "${pid}"; then
                        kill_exit=0
                    else
                        kill_exit=$?
                    fi
                    if [[ "${kill_exit}" -ne 0 ]]; then
                        echo "Error: failed to send SIGKILL to pid ${pid} in container ${container}." >&2
                        return 1
                    fi
                done
            fi
        done <<< "${matching_containers}"
    done

    if [[ "${reaped_count}" -gt 0 ]]; then
        echo "Reaped ${reaped_count} orphaned process(es)."
    else
        echo "No orphaned processes found."
    fi
    return 0
}

if "${REAP_ORPHANS}"; then
    if reap_orphans; then
        exit 0
    else
        exit 1
    fi
fi

# ── Namespacing (per-agent, so containers/volumes never collide) ──
CONTAINER_PREFIX="${AGENT}-sand"

# ── Repo scoping ─────────────────────────────────────────────────
# Inside a git repo, containers/volumes/images are namespaced per repo (see
# lib/repo-scope.sh) so each project gets its own isolated sandbox and,
# optionally, its own image (<repo-root>/.agent-sand/Dockerfile). Outside a
# git repo, fall back to the legacy shared-workspace scheme (whole ~/Repos
# mount, one container per --name) so existing claude-sand-default-style
# volumes keep working untouched.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/repo-scope.sh
source "${SCRIPT_DIR}/lib/repo-scope.sh"

if REPO_ROOT="$(resolve_repo_root)"; then
    REPO_SLUG="$(slugify "$(basename "${REPO_ROOT}")")"

    NAME_SUFFIX=""
    "${NAME_GIVEN}" && NAME_SUFFIX="-${INSTANCE_NAME}"

    CONTAINER_NAME="${CONTAINER_PREFIX}-${REPO_SLUG}${NAME_SUFFIX}"
    VOLUME_NAME="${CONTAINER_PREFIX}-home-${REPO_SLUG}${NAME_SUFFIX}"
    HOSTNAME_VALUE="sandbox-${REPO_SLUG}${NAME_SUFFIX}"

    IMAGE="$(select_image "${REPO_ROOT}" "${REPO_SLUG}")"
    USING_REPO_IMAGE=false
    has_repo_image "${REPO_ROOT}" && USING_REPO_IMAGE=true

    WORKSPACE_BIND_HOST="${REPO_ROOT}"
    WORKDIR="$(compute_workdir "${REPO_ROOT}" "${PWD}")"
    WORKSPACE_SCOPE=repo
else
    USING_REPO_IMAGE=false

    CONTAINER_NAME="${CONTAINER_PREFIX}-${INSTANCE_NAME}"
    VOLUME_NAME="${CONTAINER_PREFIX}-home-${INSTANCE_NAME}"
    HOSTNAME_VALUE="sandbox-${INSTANCE_NAME}"

    IMAGE="${MONOLITH_IMAGE}"
    WORKSPACE_BIND_HOST="${WORKSPACE_HOST}"
    WORKDIR="$(compute_legacy_workdir "${WORKSPACE_HOST}" "${PWD}")"
    WORKSPACE_SCOPE=legacy
fi

# ── Build ────────────────────────────────────────────────────────
build_base_image() {
    echo "Building ${BASE_IMAGE} with ${RUNTIME}..."
    "${RUNTIME}" build -f "${SCRIPT_DIR}/Dockerfile.base" -t "${BASE_IMAGE}" -t agent-sandbox-base:latest "${SCRIPT_DIR}"
    echo "Done."
}

ensure_base_image() {
    if ! "${RUNTIME}" image inspect "${BASE_IMAGE}" &>/dev/null; then
        build_base_image
    fi
}

build_image() {
    ensure_base_image
    echo "Building ${MONOLITH_IMAGE} with ${RUNTIME}..."
    "${RUNTIME}" build --build-arg "BASE_VERSION=${BASE_TAG}" -t "${MONOLITH_IMAGE}" -f "${SCRIPT_DIR}/Dockerfile" "${SCRIPT_DIR}"
    echo "Done."
}

build_repo_image() {
    ensure_base_image
    echo "Building ${IMAGE} with ${RUNTIME}..."
    "${RUNTIME}" build --build-arg "BASE_VERSION=${BASE_TAG}" -t "${IMAGE}" -f "${REPO_ROOT}/.agent-sand/Dockerfile" "${REPO_ROOT}/.agent-sand"
    echo "Done."
}

build_selected_image() {
    if "${USING_REPO_IMAGE}"; then
        build_repo_image
    else
        build_image
    fi
}

if "${BUILD_BASE_ONLY}"; then
    build_base_image
    exit 0
fi

if "${BUILD_ONLY}"; then
    build_selected_image
    exit 0
fi

if ! "${RUNTIME}" image inspect "${IMAGE}" &>/dev/null; then
    build_selected_image
fi

# ── Forced plugin update (--update-plugins) ──────────────────────
# Provisions anything missing, then refreshes with ttl 0 (bypassing the
# entrypoint's 30-minute stamp) inside the running container, or in a one-shot
# container against the home volume. Claude uses its host-mounted binary;
# Codex uses the CLI baked into the image.
if "${UPDATE_PLUGINS}"; then
    if [[ "${AGENT}" == codex ]]; then
        UPDATE_CMD='source /usr/local/bin/lib/migrate-settings.sh && provision_codex_plugins /home/dev/.codex cenci matteobortolazzo/cenci cenci cenci-watch && update_codex_plugins /home/dev/.codex cenci 0 cenci cenci-watch'
    else
        UPDATE_CMD='source /usr/local/bin/lib/migrate-settings.sh && heal_plugin_installs /home/dev/.claude/plugins && provision_plugins /home/dev/.claude/plugins cenci matteobortolazzo/cenci cenci cenci-watch && update_plugins /home/dev/.claude/plugins cenci 0 cenci cenci-watch'
    fi
    if "${RUNTIME}" ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
        echo "Updating plugins in running '${CONTAINER_NAME}'..."
        "${RUNTIME}" exec -u dev "${CONTAINER_NAME}" /bin/bash -c "${UPDATE_CMD}"
        echo "Done. Agent sessions pick up the update on their next start."
    else
        echo "Updating plugins in volume '${VOLUME_NAME}'..."
        UPDATE_RUN_ARGS=(--rm --entrypoint /bin/bash -e "CENCI_SANDBOX_AGENT=${AGENT}" -v "${VOLUME_NAME}:/home/dev")
        if [[ "${AGENT}" == claude ]]; then
            CLAUDE_BIN="$(readlink -f "$(which claude)" 2>/dev/null || true)"
            if [[ ! -x "${CLAUDE_BIN}" ]]; then
                echo "Error: --update-plugins needs the claude binary on the host for Claude sandboxes." >&2
                exit 1
            fi
            UPDATE_RUN_ARGS+=(-v "${CLAUDE_BIN}:/usr/local/bin/claude:ro")
        fi
        "${RUNTIME}" run "${UPDATE_RUN_ARGS[@]}" "${IMAGE}" -c "${UPDATE_CMD}"
        echo "Done."
    fi
    exit 0
fi

# ── Resolve agent binary ────────────────────────────────────────
# Claude is a self-contained binary bind-mounted from the host; Codex is baked
# into the image (npm launcher + nested native binary can't be single-file
# mounted), so only Claude needs a host binary here.
if [[ "${AGENT}" == claude ]]; then
    AGENT_BIN="$(readlink -f "$(which "${AGENT}")" 2>/dev/null || true)"
    if [[ ! -x "${AGENT_BIN}" ]]; then
        echo "Error: ${AGENT} binary not found. Install ${AGENT} on the host first." >&2
        exit 1
    fi
fi

# ── Resolve cenci (optional) ─────────────────────────────────
# Container-side mount point for the host socket directory (matches the 'dev'
# user's uid 1000, so its XDG_RUNTIME_DIR lands here regardless of the host
# uid). Named once and reused everywhere the destination path matters.
CENCI_SOCKET_MOUNT_DEST="/run/user/1000/cenci"
CENCI_BIN="$(readlink -f "$(which cenci)" 2>/dev/null || true)"
CENCI_SOCKET_DIR=""
CENCI_SOCKET_DIR_FAILED=false
if [[ -x "${CENCI_BIN}" ]]; then
    # Bounded (5s) so a hung CLI can't hang the whole launcher, and stderr is
    # captured separately so a genuine failure isn't silently indistinguishable
    # from cenci simply not being set up yet.
    CENCI_SOCKET_DIR_ERR_FILE="$(mktemp)"
    if CENCI_SOCKET_DIR="$(timeout 5s "${CENCI_BIN}" socket-dir 2>"${CENCI_SOCKET_DIR_ERR_FILE}")"; then
        :
    else
        CENCI_SOCKET_DIR_STATUS=$?
        CENCI_SOCKET_DIR=""
        CENCI_SOCKET_DIR_FAILED=true
        CENCI_SOCKET_DIR_ERR="$(cat "${CENCI_SOCKET_DIR_ERR_FILE}")"
        if [[ "${CENCI_SOCKET_DIR_STATUS}" -eq 124 ]]; then
            echo "Warning: 'cenci socket-dir' timed out after 5s; skipping cenci wiring for this launch." >&2
        else
            echo "Warning: 'cenci socket-dir' failed (exit ${CENCI_SOCKET_DIR_STATUS}): ${CENCI_SOCKET_DIR_ERR}" >&2
        fi
    fi
    rm -f "${CENCI_SOCKET_DIR_ERR_FILE}"
fi
CENCI_EVENTS_SOCKET="${CENCI_SOCKET_DIR}/cenci-events.sock"
CENCI_AVAILABLE=false

# The host daemon starts lazily (the first `cenci notify` from a host
# session spawns it), so right after boot the events socket may not exist even
# though cenci is installed. Missing it here would create the shared
# container without any cenci wiring — permanently, since the container
# is long-lived and later launches only exec into it (#195). Start the daemon
# ourselves (a redundant start is a no-op thanks to its already-running guard)
# and wait briefly for the socket to appear.
if [[ -n "${CENCI_SOCKET_DIR}" && ! -S "${CENCI_EVENTS_SOCKET}" ]]; then
    nohup "${CENCI_BIN}" daemon >/dev/null 2>&1 &
    for _ in {1..30}; do
        [[ -S "${CENCI_EVENTS_SOCKET}" ]] && break
        sleep 0.1
    done
fi

if [[ -n "${CENCI_SOCKET_DIR}" && -S "${CENCI_EVENTS_SOCKET}" ]]; then
    CENCI_AVAILABLE=true
elif [[ -x "${CENCI_BIN}" && "${CENCI_SOCKET_DIR_FAILED}" == false ]]; then
    echo "Warning: cenci is installed but its events socket is unavailable; sessions in this container will not report to the host status bars." >&2
fi

# ── Build agent command args ─────────────────────────────────────
# The container is the security boundary: the agent runs with full
# permissions inside it (rejected if root — we run as uid 1000 'dev').
if [[ "${AGENT}" == codex ]]; then
    AGENT_CMD_ARGS=(--dangerously-bypass-approvals-and-sandbox --model "${MODEL}")
else
    AGENT_CMD_ARGS=(--dangerously-skip-permissions --model "${MODEL}")
fi

# ── Exec env forwarding (for attach path) ───────────────────────
EXEC_ENV_ARGS=(-u dev -e "TMUX_PANE=${TMUX_PANE:-}" -e "CENCI_SANDBOX=1" -e "CENCI_SANDBOX_AGENT=${AGENT}")
[[ -n "${CONTEXT7_API_KEY:-}" ]] && EXEC_ENV_ARGS+=(-e "CONTEXT7_API_KEY=${CONTEXT7_API_KEY}")
[[ -n "${OPENAI_API_KEY:-}" ]] && EXEC_ENV_ARGS+=(-e "OPENAI_API_KEY=${OPENAI_API_KEY}")

run_agent() {
    if "${SHELL_ONLY}"; then
        echo "Attaching shell to running '${CONTAINER_NAME}'..."
        "${RUNTIME}" exec -it "${EXEC_ENV_ARGS[@]}" "${CONTAINER_NAME}" /bin/bash
    else
        "${RUNTIME}" exec -it "${EXEC_ENV_ARGS[@]}" "${CONTAINER_NAME}" "${AGENT}" "${AGENT_CMD_ARGS[@]}" "${AGENT_ARGS[@]}"
    fi
}

wait_until_ready() {
    local ready=false
    local attempt
    for ((attempt = 0; attempt < 600; attempt++)); do
        if "${RUNTIME}" exec -u dev "${CONTAINER_NAME}" test -e /tmp/agent-sand-ready 2>/dev/null; then
            ready=true
            break
        fi
        sleep 0.1
    done
    if ! "${ready}"; then
        echo "Error: container '${CONTAINER_NAME}' did not become ready within 60 seconds." >&2
        return 1
    fi
}

# A running container's mounts are fixed for its whole lifetime: if it was
# created while the host events socket was missing, attaching can never bring
# the cenci wiring back. Detect that and say how to fix it instead of
# letting sessions silently vanish from the host status bars (#195).
warn_if_unwired() {
    "${CENCI_AVAILABLE}" || return 0
    if ! "${RUNTIME}" inspect --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' "${CONTAINER_NAME}" 2>/dev/null \
        | grep -qx "${CENCI_SOCKET_MOUNT_DEST}"; then
        echo "Warning: container '${CONTAINER_NAME}' was created without cenci wiring; its sessions will not report to the host status bars. Run '${RUNTIME} stop ${CONTAINER_NAME}' and relaunch to fix." >&2
    fi
}

# ── Attach to running container ─────────────────────────────────
if "${RUNTIME}" ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
    warn_if_unwired
    # Containers created by this launcher initialize asynchronously. Older
    # attached containers have no lifecycle label and are already initialized.
    if [[ "$("${RUNTIME}" inspect --format '{{ index .Config.Labels "cenci-sand.lifecycle" }}' "${CONTAINER_NAME}" 2>/dev/null || true)" == detached ]]; then
        wait_until_ready
    fi
    run_agent
    exit $?
fi

# Remove stopped container if it exists
"${RUNTIME}" rm "${CONTAINER_NAME}" &>/dev/null || true

# ── Assemble run args ───────────────────────────────────────────
RUN_ARGS=(
    --name "${CONTAINER_NAME}"
    --hostname "${HOSTNAME_VALUE}"
    --label "cenci-sand.lifecycle=detached"
    -d --init --rm
    --workdir "${WORKDIR}"

    # Start as root so entrypoint.sh can usermod/groupmod the 'dev' account to
    # match HOST_UID/HOST_GID before any process runs under it (usermod/groupmod
    # refuse to renumber an account with a running process — #154). entrypoint.sh
    # unconditionally drops to 'dev' before running the workload. Docker/Podman
    # persist --user as the container's Config.User for its whole lifetime, so
    # `exec` without an explicit -u falls back to that persisted "root", NOT the
    # image's original `USER dev` Dockerfile directive — every exec call site
    # (EXEC_ENV_ARGS above, and the --update-plugins exec) must pass `-u dev`
    # explicitly for exactly this reason.
    --user root

    # Workspace
    -v "${WORKSPACE_BIND_HOST}:${WORKSPACE_CONTAINER}"

    # Persistent home
    -v "${VOLUME_NAME}:/home/dev"

    # Terminal
    -e "TERM=${TERM:-xterm-256color}"

    # Container marker (both docker & podman) — cenci configure detects this
    -e "CENCI_SANDBOX=1"

    # Internal contract used by the entrypoint to provision the selected
    # agent's native plugin store.
    -e "CENCI_SANDBOX_AGENT=${AGENT}"

    # Host identity — entrypoint remaps 'dev' to this UID/GID on mismatch (#154)
    -e "HOST_UID=$(id -u)"
    -e "HOST_GID=$(id -g)"
    -e "WORKSPACE_SCOPE=${WORKSPACE_SCOPE}"
)

# Claude binary (read-only); Codex is baked into the image instead
if [[ "${AGENT}" == claude ]]; then
    RUN_ARGS+=(-v "${AGENT_BIN}:/usr/local/bin/claude:ro")
fi

# Git config (read-only, if exists)
for gitconfig in "${HOME}/.config/git/config" "${HOME}/.gitconfig"; do
    if [[ -f "${gitconfig}" ]]; then
        RUN_ARGS+=(-v "${gitconfig}:/home/dev/.gitconfig:ro")
        break
    fi
done

# Cenci (optional)
if "${CENCI_AVAILABLE}"; then
    RUN_ARGS+=(
        -v "${CENCI_BIN}:/usr/local/bin/cenci:ro"
        -v "${CENCI_SOCKET_DIR}:${CENCI_SOCKET_MOUNT_DEST}:ro"
        -e "XDG_RUNTIME_DIR=/run/user/1000"
        -e "TMUX_PANE=${TMUX_PANE:-}"
    )
fi

# Claude credentials (read-only staging — entrypoint seeds into /home/dev only
# when the volume has none, since rotating refresh tokens fork per copy; #259)
CLAUDE_CREDS="${HOME}/.claude/.credentials.json"
if [[ -f "${CLAUDE_CREDS}" ]]; then
    RUN_ARGS+=(-v "${CLAUDE_CREDS}:/tmp/host-claude-creds/.credentials.json:ro")
fi

# Force a reseed from the host (recovery after the volume's token chain died,
# e.g. all sessions were revoked)
if "${RESEED_CREDS}"; then
    RUN_ARGS+=(-e "CENCI_SANDBOX_RESEED_CREDS=1")
fi

# Codex credentials (ChatGPT sign-in and/or API key — fail hard if neither present)
if [[ "${AGENT}" == codex ]]; then
    has_auth=false
    [[ -f "${HOME}/.codex/auth.json" ]] && { RUN_ARGS+=(-v "${HOME}/.codex/auth.json:/tmp/host-codex-creds/auth.json:ro"); has_auth=true; }
    [[ -n "${OPENAI_API_KEY:-}" ]]      && { RUN_ARGS+=(-e "OPENAI_API_KEY=${OPENAI_API_KEY}"); has_auth=true; }
    "${has_auth}" || { echo "Error: --agent codex requires Codex auth. Run 'codex login' on the host (creates ~/.codex/auth.json) or export OPENAI_API_KEY." >&2; exit 1; }
fi

# GitHub CLI credentials (read-only staging — entrypoint copies to /home/dev)
GH_HOSTS="${HOME}/.config/gh/hosts.yml"
if [[ -f "${GH_HOSTS}" ]]; then
    RUN_ARGS+=(-v "${GH_HOSTS}:/tmp/host-gh-config/hosts.yml:ro")
fi

# Host network mode (fallback for manual OAuth inside container)
if "${HOST_NETWORK}"; then
    echo "Warning: --host-network weakens the container's isolation boundary (the container is the security boundary); only use it for manual OAuth callback." >&2
    RUN_ARGS+=(--network host)
fi

[[ -n "${COLORTERM:-}" ]] && RUN_ARGS+=(-e "COLORTERM=${COLORTERM}")
[[ -n "${CONTEXT7_API_KEY:-}" ]] && RUN_ARGS+=(-e "CONTEXT7_API_KEY=${CONTEXT7_API_KEY}")

# Docker socket (opt-in DooD)
if "${DOCKER_SOCKET}"; then
    DOCKER_SOCK=""
    if [[ -S /var/run/docker.sock ]]; then
        DOCKER_SOCK="/var/run/docker.sock"
    elif [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]]; then
        DOCKER_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
    fi
    if [[ -n "${DOCKER_SOCK}" ]]; then
        RUN_ARGS+=(-v "${DOCKER_SOCK}:/var/run/docker.sock")
    else
        echo "Warning: --docker requested but no container runtime socket found." >&2
    fi
fi

# ── Start shared container, then exec this agent into it ─────────
# Keep PID 1 independent from every tmux pane. If the first pane owns an
# attached `docker run`, closing it forwards SIGHUP to PID 1 and tears down all
# later `docker exec` sessions in the same repository. A detached idle process
# makes every agent window an equal, independently disposable exec session.
"${RUNTIME}" run "${RUN_ARGS[@]}" "${IMAGE}" \
    -c 'touch /tmp/agent-sand-ready && exec sleep infinity' >/dev/null

# The entrypoint performs credential and plugin setup before running the
# readiness command. Do not race the first agent against that initialization.
wait_until_ready
run_agent
