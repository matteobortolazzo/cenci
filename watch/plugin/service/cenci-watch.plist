<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by cenci daemon install-service -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.matteobortolazzo.cenci-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>@CENCI_HOME@/.local/bin/cenci</string>
		<string>daemon</string>
		<string>start</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
@CENCI_ENVIRONMENT@
	</dict>
</dict>
</plist>
