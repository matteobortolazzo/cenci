#!/usr/bin/env bash
# Stable front door for installing, updating, and diagnosing cenci. The
# installed wrapper resolves and validates its checkout root, then executes
# the installer from that exact cenci marketplace checkout; the ref-aware
# marketplace refresh itself is delegated entirely to install.sh's own
# step_marketplace (#625) rather than being repeated here, while doctor
# remains strictly local and read-only.
set -euo pipefail

source_path=${BASH_SOURCE[0]}
link_depth=0
while [[ -L "${source_path}" ]]; do
	link_depth=$((link_depth + 1))
	if [[ ${link_depth} -gt 16 ]]; then
		printf 'Error: too many installer symlink levels.\n' >&2
		exit 1
	fi
	if ! source_parent=$(dirname "${source_path}"); then
		printf 'Error: could not inspect installer directory.\n' >&2
		exit 1
	fi
	if ! source_dir=$(cd -P "${source_parent}" >/dev/null 2>&1 && pwd); then
		printf 'Error: could not resolve installer directory.\n' >&2
		exit 1
	fi
	if ! link_target=$(readlink "${source_path}"); then
		printf 'Error: could not resolve installer symlink.\n' >&2
		exit 1
	fi
	if [[ "${link_target}" = /* ]]; then
		source_path=${link_target}
	else
		source_path=${source_dir}/${link_target}
	fi
done
if ! source_parent=$(dirname "${source_path}"); then
	printf 'Error: could not inspect installer root.\n' >&2
	exit 1
fi
if ! source_dir=$(cd -P "${source_parent}" >/dev/null 2>&1 && pwd); then
	printf 'Error: could not resolve installer root.\n' >&2
	exit 1
fi
installer=${source_dir}/install.sh

if [[ ! -f "${installer}" ]]; then
	printf 'Error: bundled installer not found at %s. Re-run the official install command.\n' "${installer}" >&2
	exit 1
fi

case "${1:-}" in
doctor | --help | -h)
	# doctor is strictly local/read-only, and install.sh handles --help/-h
	# itself after exec. None of these should pay for (or require) a
	# checkout refresh, and a read-only invocation from a copied wrapper
	# should still work.
	;;
*)
	# install.sh's own step_marketplace (#625) now removes and re-adds the
	# marketplace registration at the resolved ref on every run, so a
	# pre-exec `marketplace update`/`upgrade` here would be redundant at
	# best — and, since neither client's ref-less update/upgrade semantics
	# are verified, could transiently repoint the checkout to an
	# unpinned/main state before install.sh corrects it right back. Leave
	# the checkout refresh to install.sh's single, ref-aware seam instead;
	# this block only still needs to confirm source_dir is either that
	# managed checkout or an explicit local dev checkout.
	managed_claude_dir=${HOME}/.claude/plugins/marketplaces/cenci
	resolved_claude_dir=""
	if [[ -d "${managed_claude_dir}" ]]; then
		if ! resolved_claude_dir=$(cd -P "${managed_claude_dir}" >/dev/null 2>&1 && pwd); then
			resolved_claude_dir=""
		fi
	fi

	managed_codex_dir=${HOME}/.codex/plugins/marketplaces/cenci
	resolved_codex_dir=""
	if [[ -d "${managed_codex_dir}" ]]; then
		if ! resolved_codex_dir=$(cd -P "${managed_codex_dir}" >/dev/null 2>&1 && pwd); then
			resolved_codex_dir=""
		fi
	fi

	case "${source_dir}" in
	"${resolved_claude_dir}" | "${resolved_codex_dir}")
		: # managed checkout; install.sh's step_marketplace refreshes it.
		;;
	*)
		# A directly invoked source checkout is already an explicit, local
		# authority. Keep that development path working, but do not accept an
		# arbitrary copied wrapper as an updater.
		if [[ ! -e "${source_dir}/.git" ]]; then
			printf 'Error: refusing to update from unexpected installer root: %s\n' "${source_dir}" >&2
			exit 1
		fi
		;;
	esac
	;;
esac

exec bash "${installer}" "$@"
