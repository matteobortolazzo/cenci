{
  "sandbox": {
    "enabled": false
  },
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Read(~/.claude/plugins/**)",
      "Read(//tmp/claude*/**)",
      "Edit(//tmp/claude*/**)",
      "Bash(cd:*)",
      "Bash(dotnet:*)",
      "Bash(npm:*)",
      "Bash(ng:*)",
      "Bash(go:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(wc:*)",
      "SlashCommand(/goal:*)",
      "SlashCommand(/loop:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(~/.ssh/)",
      "Read(~/.aws/)",
      "Read(.env)"
    ]
  }
}
