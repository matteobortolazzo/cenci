{
  "configVersion": "0.45.0",
  "branchPattern": "feature/<id>-<description>",
  "isMonorepo": true,
  "stack": {
    "backend": "go1.25",
    "testing": ["go-testing", "shellcheck"]
  },
  "projects": [
    {
      "slug": "flow",
      "path": "flow",
      "name": "flow",
      "description": "Claude Code plugin: markdown skills, agents, shell hooks",
      "stack": { "framework": "markdown-shell" },
      "buildCommand": "",
      "testCommand": "",
      "gateCommand": "bash scripts/run-checks.sh"
    },
    {
      "slug": "watch",
      "path": "watch",
      "name": "watch",
      "description": "Go binary + Claude Code plugin: coding-agent session monitoring (tmux, waybar, noctalia, DMS)",
      "stack": { "framework": "go1.25", "testing": "go-testing" },
      "buildCommand": "make build",
      "testCommand": "make test",
      "lintCommand": "make lint",
      "gateCommand": "make test",
      "serveCommand": "go run .",
      "boardKey": "Rw",
      "testKey": "Tw",
      "automerge": {
        "protectedPaths": ["watch/internal/sandbox/", "watch/internal/babysit/", "watch/plugin/", "*credential*", "*secret*"],
        "maxChangedFiles": 15,
        "maxDiffLines": 800,
        "mergeMethod": "squash"
      }
    },
    {
      "slug": "sandbox",
      "path": "sandbox",
      "name": "sandbox",
      "description": "Docker/Podman container for isolated Claude Code sessions",
      "stack": { "framework": "docker-shell", "testing": "shellcheck" },
      "buildCommand": "docker build",
      "testCommand": "",
      "gateCommand": "n=0; for t in tests/*.test.sh; do [ \"$t\" = tests/smoke.test.sh ] && continue; bash \"$t\" || exit 1; n=$((n+1)); done; [ \"$n\" -gt 0 ] || exit 1"
    }
  ],
  "guidanceLocation": "AGENTS.md",
  "mcpServers": {
    "context7": true
  },
  "lspServers": {
    "gopls": true,
    "pyright": true
  },
  "autoCompactDisabled": true,
  "pinSubagents200K": false,
  "sandbox": {
    "enabled": true,
    "baseVersion": "1.16.9"
  },
  "lazyboards": {
    "enabled": true
  },
  "maintenance": {
    "enabled": true,
    "checkDuringImplement": true,
    "remindAfterDays": 30,
    "generatedDocs": true
  }
}
