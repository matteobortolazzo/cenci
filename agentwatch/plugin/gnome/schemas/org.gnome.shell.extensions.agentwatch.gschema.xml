<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.agentwatch"
          path="/org/gnome/shell/extensions/agentwatch/">
    <key name="poll-interval-ms" type="i">
      <default>2000</default>
      <range min="250" max="60000"/>
      <summary>Poll interval (ms)</summary>
      <description>How often to run "agentwatch status".</description>
    </key>
    <key name="agentwatch-path" type="s">
      <default>'agentwatch'</default>
      <summary>agentwatch binary path</summary>
      <description>Path or command name for the agentwatch binary. Use an absolute path if it is not on the GNOME session PATH.</description>
    </key>
  </schema>
</schemalist>
