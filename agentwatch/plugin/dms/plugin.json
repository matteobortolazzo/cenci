{
  "id": "agentwatch",
  "name": "AgentWatch",
  "description": "Live counts of Claude Code and Codex tmux sessions (running / need-input / done / stopped / idle).",
  "version": "3.0.0",
  "author": "Matteo Bortolazzo",
  "type": "widget",
  "capabilities": [
    "dankbar-widget",
    "monitoring"
  ],
  "component": "./AgentWatchWidget.qml",
  "settings": "./AgentWatchSettings.qml",
  "icon": "smart_toy",
  "requires_dms": ">=0.1.0",
  "requires": [
    "agentwatch"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
